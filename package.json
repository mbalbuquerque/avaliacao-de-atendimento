{
  "name": "avalie-o-atendimento",
  "version": "1.0.0",
  "description": "Avalie o Atendimento: avaliações anônimas com indicadores por serviço (Cloud Challenge, desafio 13).",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
    "test": "node --test --test-concurrency=1",
    "banco": "node scripts/setup-db.js",
    "hash": "node scripts/gerar-hash.js",
    "test:cobertura": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=90 --test-coverage-branches=80",
    "lint": "eslint .",
    "auditar": "npm audit --omit=dev --audit-level=high",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.js"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
