# Modelo de variáveis de ambiente. Copie para .env (que o Git ignora) e preencha.
# Na Azure, estes valores ficam em Configurações do aplicativo, não em arquivo.

# Conexão com o PostgreSQL (valores de exemplo)
DATABASE_URL=postgres://USUARIO:SENHA@SERVIDOR.postgres.database.azure.com:5432/BANCO?sslmode=require

# Porta local (na Azure o App Service define PORT sozinho)
PORT=3000

# Moderação: usuário e hash scrypt da senha (gere com: npm run hash -- "sua-senha")
ADMIN_USUARIO=gestor
ADMIN_SENHA_HASH=scrypt$SALT_HEX$HASH_HEX

# Segredo que assina a sessão do gestor (32 caracteres ou mais, aleatório)
SESSAO_SEGREDO=troque-por-um-valor-aleatorio-com-32-caracteres-ou-mais
