# Modelo de variáveis de ambiente. Copie para .env (que o Git ignora) e preencha.
# Na Azure, estes valores ficam em Configurações do aplicativo, não em arquivo.

# Conexão com o PostgreSQL (valores de exemplo)
DATABASE_URL=postgres://USUARIO:SENHA@SERVIDOR.postgres.database.azure.com:5432/BANCO?sslmode=require

# Porta local (na Azure o App Service define PORT sozinho)
PORT=3000

# Moderação: usuário e hash scrypt da senha (gere com: npm run hash -- "sua-senha")
ADMIN_USUARIO=gestor
ADMIN_SENHA_HASH=scrypt$SALT_HEX$HASH_HEX

# Segredo que assina a sessão do gestor (32 caracteres ou mais, aleatório)
SESSAO_SEGREDO=troque-por-um-valor-aleatorio-com-32-caracteres-ou-mais

# ---------------------------------------------------------------------------
# Ajustes opcionais. Todos têm padrão e SÓ precisam existir se quiser mudar.
# Valor inválido (texto, zero, negativo) faz a aplicação falhar na subida com uma
# mensagem clara; nunca volta em silêncio para o padrão.
# ---------------------------------------------------------------------------

# Limites por IP, em memória, por minuto (padrão entre parênteses)
# LIMITE_GERAL_POR_MINUTO=600        # todas as rotas (o /health nunca é limitado)
# LIMITE_AVALIACOES_POR_MINUTO=30    # envio de avaliações
# LIMITE_LOGIN_TENTATIVAS=10         # tentativas de login por IP...
# LIMITE_LOGIN_JANELA_MINUTOS=15     # ...dentro desta janela

# Sessão do gestor, em horas (aceita decimais: 0,5 = 30 minutos)
# SESSAO_HORAS=8

# Tamanhos
# TAMANHO_MAXIMO_CORPO_KB=10         # corpo máximo de uma requisição
# COMENTARIOS_PUBLICOS_MAXIMO=100    # comentários na lista pública
# AVALIACOES_GESTOR_MAXIMO=500       # avaliações na lista do gestor

# Pool de conexões com o PostgreSQL
# BANCO_CONEXOES_MAXIMAS=5
# BANCO_TIMEOUT_CONEXAO_MS=5000
# BANCO_TIMEOUT_OCIOSO_MS=30000
